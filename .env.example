# Copier ce fichier en .env puis remplacer chaque CHANGE_ME.
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).

MYSQL_DATABASE=huilerie_erp
MYSQL_USER=huilerie_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Générer par exemple avec : openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION_MINUTES=480

APP_PORT=8080
BACKEND_PORT=8090
MYSQL_PORT=3307
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Premier démarrage uniquement (base vide). À vider après la première connexion.
# Mot de passe : 10 caractères minimum, au moins une lettre et un chiffre.
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=
